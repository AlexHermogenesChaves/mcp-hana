    "config": "node src/configurar.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sap/hana-client": "^2.30.27",
    "mssql": "^12.7.14",
    "zod": "^4.6.7"
  }
